# Django
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Leave empty locally to use SQLite. In production: postgres://user:pass@host:5432/db
DATABASE_URL=

# AI (any OpenAI-compatible API). Default: Google Gemini (free key at https://aistudio.google.com/apikey).
# gemini-3.5-flash-lite allows 15 requests/min on the free tier (gemini-3.8-flash: 5).
# For OpenAI instead: leave OPENAI_BASE_URL empty and set OPENAI_MODEL=gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.5-flash-lite

# WhatsApp Cloud API (Meta for Developers → your app → WhatsApp)
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=

# New-order alerts: optional approved WhatsApp template (4 body variables: order number, items,
# total and payment, delivery or pickup). Without it alerts are free-form and only arrive within
# 24 hours of the alert number messaging the restaurant's number.
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_ALERT_TEMPLATE_LANGUAGE=en
# Minutes the bot stays quiet after the owner replies from the WhatsApp Business app (Coexistence).
OWNER_REPLY_PAUSE_MINUTES=30

# Menu photos: on Vercel (no writable disk), create a Blob store and set its read-write token.
# Without it, photos are saved to MEDIA_ROOT locally, and the photo field is hidden on Vercel.
BLOB_READ_WRITE_TOKEN=

# Web demo
DEMO_RESTAURANT_SLUG=dar-tangier
DEMO_MESSAGES_PER_SESSION=40
# Show "Try the demo" on /login/: one click signs in as DEMO_STAFF_USERNAME, limited to the demo restaurant.
# That account can move orders but can't change the menu or settings.
DEMO_LOGIN_ENABLED=false
DEMO_STAFF_USERNAME=demo
