# Django
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Leave empty locally to use SQLite. In production: postgres://user:pass@host:5432/db
DATABASE_URL=

# AI (any OpenAI-compatible API). Leave OPENAI_BASE_URL empty for OpenAI.
# Gemini: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ and a Gemini model name
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (Meta for Developers → your app → WhatsApp)
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=

# Web demo
DEMO_RESTAURANT_SLUG=dar-tangier
DEMO_MESSAGES_PER_SESSION=40
